{
  "colorScheme": "tokyo night",
  "statusLine": {
    "type": "",
    "command": "",
    "enabled": true
  },
  "trustedWorkspaces": [],
  "enableTerminalSandbox": true,
  "sandbox": {
    "enabled": true,
    "network": {
      "allowedDomains": [
        "github.com",
        "*.github.com",
        "*.githubusercontent.com",
        "api.github.com"
      ]
    },
    "credentials": {
      "files": [
        { "path": "~/.ssh", "mode": "deny" },
        { "path": "~/.gnupg", "mode": "deny" },
        { "path": "~/.claude.json", "mode": "deny" },
        { "path": "~/.boto", "mode": "deny" },
        { "path": "~/.bashrc", "mode": "deny" },
        { "path": "~/.bashrc.backup", "mode": "deny" },
        { "path": "~/.bash_history", "mode": "deny" },
        { "path": "~/.zsh_history", "mode": "deny" },
        { "path": "~/.python_history", "mode": "deny" },
        { "path": "~/.lesshst", "mode": "deny" },
        { "path": "~/.aws", "mode": "deny" },
        { "path": "~/.azure", "mode": "deny" },
        { "path": "~/.netrc", "mode": "deny" },
        { "path": "~/.npmrc", "mode": "deny" },
        { "path": "~/.git-credentials", "mode": "deny" },
        { "path": "~/.config/gcloud", "mode": "deny" },
        { "path": "~/.config/rclone", "mode": "deny" },
        { "path": "~/.docker/config.json", "mode": "deny" },
        { "path": "~/.claude/.credentials.json", "mode": "deny" }
      ],
      "envVars": [
        { "name": "ANTHROPIC_API_KEY", "mode": "deny" },
        { "name": "AWS_ACCESS_KEY_ID", "mode": "deny" },
        { "name": "AWS_SECRET_ACCESS_KEY", "mode": "deny" },
        { "name": "AWS_SESSION_TOKEN", "mode": "deny" },
        { "name": "GITHUB_TOKEN", "mode": "deny" },
        { "name": "GH_TOKEN", "mode": "deny" },
        { "name": "NPM_TOKEN", "mode": "deny" },
        { "name": "OPENAI_API_KEY", "mode": "deny" },
        { "name": "HOMEBREW_GITHUB_API_TOKEN", "mode": "deny" },
        { "name": "GEMINI_API_KEY", "mode": "deny" },
        { "name": "GOOGLE_API_KEY", "mode": "deny" },
        { "name": "GOOGLE_APPLICATION_CREDENTIALS", "mode": "deny" }
      ]
    }
  },
  "permissions": {
    "defaultMode": "acceptEdits",
    "disableBypassPermissionsMode": "disable",
    "ask": [
      "Bash(rm -rf *)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard*)",
      "Bash(git clean -f*)",
      "command(rm -rf *)",
      "command(git push --force*)",
      "command(git push -f*)",
      "command(git reset --hard*)",
      "command(git clean -f*)"
    ],
    "deny": [
      "Read(~/.ssh/**)",
      "Edit(~/.ssh/**)",
      "Write(~/.ssh/**)",
      "Grep(~/.ssh/**)",
      "Glob(~/.ssh/**)",
      "read_file(~/.ssh/**)",
      "write_file(~/.ssh/**)",
      
      "Read(~/.gnupg/**)",
      "Edit(~/.gnupg/**)",
      "Write(~/.gnupg/**)",
      "Grep(~/.gnupg/**)",
      "Glob(~/.gnupg/**)",
      "read_file(~/.gnupg/**)",
      "write_file(~/.gnupg/**)",

      "Read(~/.claude.json)",
      "Edit(~/.claude.json)",
      "Write(~/.claude.json)",
      "Grep(~/.claude.json)",
      "Glob(~/.claude.json)",
      "read_file(~/.claude.json)",
      "write_file(~/.claude.json)",

      "Read(~/.boto)",
      "Edit(~/.boto)",
      "Write(~/.boto)",
      "Grep(~/.boto)",
      "Glob(~/.boto)",
      "read_file(~/.boto)",
      "write_file(~/.boto)",

      "Read(~/.bashrc)",
      "Edit(~/.bashrc)",
      "Write(~/.bashrc)",
      "Grep(~/.bashrc)",
      "Glob(~/.bashrc)",
      "read_file(~/.bashrc)",
      "write_file(~/.bashrc)",

      "Read(~/.bashrc.backup)",
      "Edit(~/.bashrc.backup)",
      "Write(~/.bashrc.backup)",
      "Grep(~/.bashrc.backup)",
      "Glob(~/.bashrc.backup)",
      "read_file(~/.bashrc.backup)",
      "write_file(~/.bashrc.backup)",

      "Read(~/.bash_history)",
      "Edit(~/.bash_history)",
      "Write(~/.bash_history)",
      "Grep(~/.bash_history)",
      "Glob(~/.bash_history)",
      "read_file(~/.bash_history)",
      "write_file(~/.bash_history)",

      "Read(~/.zsh_history)",
      "Edit(~/.zsh_history)",
      "Write(~/.zsh_history)",
      "Grep(~/.zsh_history)",
      "Glob(~/.zsh_history)",
      "read_file(~/.zsh_history)",
      "write_file(~/.zsh_history)",

      "Read(~/.python_history)",
      "Edit(~/.python_history)",
      "Write(~/.python_history)",
      "Grep(~/.python_history)",
      "Glob(~/.python_history)",
      "read_file(~/.python_history)",
      "write_file(~/.python_history)",

      "Read(~/.lesshst)",
      "Edit(~/.lesshst)",
      "Write(~/.lesshst)",
      "Grep(~/.lesshst)",
      "Glob(~/.lesshst)",
      "read_file(~/.lesshst)",
      "write_file(~/.lesshst)",

      "Read(~/.aws/**)",
      "Edit(~/.aws/**)",
      "Write(~/.aws/**)",
      "Grep(~/.aws/**)",
      "Glob(~/.aws/**)",
      "read_file(~/.aws/**)",
      "write_file(~/.aws/**)",

      "Read(~/.azure/**)",
      "Edit(~/.azure/**)",
      "Write(~/.azure/**)",
      "Grep(~/.azure/**)",
      "Glob(~/.azure/**)",
      "read_file(~/.azure/**)",
      "write_file(~/.azure/**)",

      "Read(~/.netrc)",
      "Edit(~/.netrc)",
      "Write(~/.netrc)",
      "Grep(~/.netrc)",
      "Glob(~/.netrc)",
      "read_file(~/.netrc)",
      "write_file(~/.netrc)",

      "Read(~/.npmrc)",
      "Edit(~/.npmrc)",
      "Write(~/.npmrc)",
      "Grep(~/.npmrc)",
      "Glob(~/.npmrc)",
      "read_file(~/.npmrc)",
      "write_file(~/.npmrc)",

      "Read(~/.git-credentials)",
      "Edit(~/.git-credentials)",
      "Write(~/.git-credentials)",
      "Grep(~/.git-credentials)",
      "Glob(~/.git-credentials)",
      "read_file(~/.git-credentials)",
      "write_file(~/.git-credentials)",

      "Read(~/.config/gcloud/**)",
      "Edit(~/.config/gcloud/**)",
      "Write(~/.config/gcloud/**)",
      "Grep(~/.config/gcloud/**)",
      "Glob(~/.config/gcloud/**)",
      "read_file(~/.config/gcloud/**)",
      "write_file(~/.config/gcloud/**)",

      "Read(~/.config/rclone/**)",
      "Edit(~/.config/rclone/**)",
      "Write(~/.config/rclone/**)",
      "Grep(~/.config/rclone/**)",
      "Glob(~/.config/rclone/**)",
      "read_file(~/.config/rclone/**)",
      "write_file(~/.config/rclone/**)",

      "Read(~/.docker/config.json)",
      "Edit(~/.docker/config.json)",
      "Write(~/.docker/config.json)",
      "Grep(~/.docker/config.json)",
      "Glob(~/.docker/config.json)",
      "read_file(~/.docker/config.json)",
      "write_file(~/.docker/config.json)",

      "Read(~/.claude/.credentials.json)",
      "Edit(~/.claude/.credentials.json)",
      "Write(~/.claude/.credentials.json)",
      "Grep(~/.claude/.credentials.json)",
      "Glob(~/.claude/.credentials.json)",
      "read_file(~/.claude/.credentials.json)",
      "write_file(~/.claude/.credentials.json)"
    ]
  }
}
