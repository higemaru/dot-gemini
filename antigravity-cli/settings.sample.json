{
  "colorScheme": "tokyo night",
  "statusLine": {
    "type": "",
    "command": "",
    "enabled": true
  },
  "trustedWorkspaces": [],
  "enableTerminalSandbox": true,
  "sandbox": {
    "enabled": true,
    "network": {
      "allowedDomains": [
        "github.com",
        "*.github.com",
        "*.githubusercontent.com",
        "api.github.com"
      ]
    },
    "credentials": {
      "files": [
        { "path": "~/.ssh", "mode": "deny" },
        { "path": "~/.gnupg", "mode": "deny" },
        { "path": "~/.claude.json", "mode": "deny" },
        { "path": "~/.boto", "mode": "deny" },
        { "path": "~/.bashrc", "mode": "deny" },
        { "path": "~/.bashrc.backup", "mode": "deny" },
        { "path": "~/.bash_history", "mode": "deny" },
        { "path": "~/.zsh_history", "mode": "deny" },
        { "path": "~/.python_history", "mode": "deny" },
        { "path": "~/.lesshst", "mode": "deny" },
        { "path": "~/.aws", "mode": "deny" },
        { "path": "~/.azure", "mode": "deny" },
        { "path": "~/.netrc", "mode": "deny" },
        { "path": "~/.npmrc", "mode": "deny" },
        { "path": "~/.git-credentials", "mode": "deny" },
        { "path": "~/.config/gcloud", "mode": "deny" },
        { "path": "~/.config/rclone", "mode": "deny" },
        { "path": "~/.docker/config.json", "mode": "deny" },
        { "path": "~/.claude/.credentials.json", "mode": "deny" }
      ],
      "envVars": [
        { "name": "ANTHROPIC_API_KEY", "mode": "deny" },
        { "name": "AWS_ACCESS_KEY_ID", "mode": "deny" },
        { "name": "AWS_SECRET_ACCESS_KEY", "mode": "deny" },
        { "name": "AWS_SESSION_TOKEN", "mode": "deny" },
        { "name": "GITHUB_TOKEN", "mode": "deny" },
        { "name": "GH_TOKEN", "mode": "deny" },
        { "name": "NPM_TOKEN", "mode": "deny" },
        { "name": "OPENAI_API_KEY", "mode": "deny" },
        { "name": "HOMEBREW_GITHUB_API_TOKEN", "mode": "deny" },
        { "name": "GEMINI_API_KEY", "mode": "deny" },
        { "name": "GOOGLE_API_KEY", "mode": "deny" },
        { "name": "GOOGLE_APPLICATION_CREDENTIALS", "mode": "deny" }
      ]
    }
  },
  "permissions": {
    "defaultMode": "acceptEdits",
    "disableBypassPermissionsMode": "disable",
    "ask": [
      "command(rm -rf)",
      "command(git push --force.*)",
      "command(git push -f)",
      "command(git reset --hard)",
      "command(git clean -f.*)"
    ],
    "deny": [
      "read_file(~/.ssh)",
      "read_file(~/.gnupg)",
      "read_file(~/.claude.json)",
      "read_file(~/.boto)",
      "read_file(~/.bashrc)",
      "read_file(~/.bashrc.backup)",
      "read_file(~/.bash_history)",
      "read_file(~/.zsh_history)",
      "read_file(~/.python_history)",
      "read_file(~/.lesshst)",
      "read_file(~/.aws)",
      "read_file(~/.azure)",
      "read_file(~/.netrc)",
      "read_file(~/.npmrc)",
      "read_file(~/.git-credentials)",
      "read_file(~/.config/gcloud)",
      "read_file(~/.config/rclone)",
      "read_file(~/.docker/config.json)",
      "read_file(~/.claude/.credentials.json)"
    ]
  }
}
